<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar.Fullscreen">
        <!-- Shown by Android before Compose draws its first frame. -->
        <item name="android:windowBackground">@drawable/startup_background</item>
        <item name="android:colorAccent">#66CBFF</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:navigationBarColor">#080B12</item>
        <item name="android:statusBarColor">#080B12</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
