<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:keepScreenOn="true"
        app:surface_type="texture_view"
        app:resize_mode="fit"
        app:use_controller="false"
        app:show_buffering="when_playing" />

    <LinearLayout
        android:id="@+id/player_top_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="#CC0A101A">

        <Button
            android:id="@+id/btn_top_back"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="‹ Geri"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/player_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/player_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:textColor="#64E5C0"
            android:textSize="13sp"
            android:text="Bağlanıyor…" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/player_bottom_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="14dp"
        android:background="#E60A101A">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/tv_current_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:text="00:00" />

            <SeekBar
                android:id="@+id/player_progress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:max="1000" />

            <TextView
                android:id="@+id/tv_total_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#9CAEC3"
                android:textSize="13sp"
                android:text="00:00" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/tools_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btn_rewind"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="⏪ 10s" />

                <Button
                    android:id="@+id/btn_play_pause"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="❚❚ Duraklat"
                    android:layout_marginStart="8dp" />

                <Button
                    android:id="@+id/btn_forward"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="10s ⏩"
                    android:layout_marginStart="8dp" />

                <Button
                    android:id="@+id/btn_resize"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="📺 Boyut: Sığdır"
                    android:layout_marginStart="8dp" />

                <Button
                    android:id="@+id/btn_quality"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="⚙️ Kalite: Otomatik"
                    android:layout_marginStart="8dp" />

                <Button
                    android:id="@+id/btn_audio"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="🔊 Ses Dili"
                    android:layout_marginStart="8dp" />

                <Button
                    android:id="@+id/btn_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="💬 Altyazı"
                    android:layout_marginStart="8dp" />

                <Button
                    android:id="@+id/btn_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="⚡ 1.0×"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
</FrameLayout>
