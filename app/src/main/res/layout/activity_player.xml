<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Zero Latency Hardware Surface Player -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:keepScreenOn="true"
        app:surface_type="surface_view"
        app:resize_mode="fit"
        app:use_controller="false"
        app:show_buffering="never" />

    <!-- Center Buffering Spinner Layout -->
    <LinearLayout
        android:id="@+id/player_buffering_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp"
        android:background="@drawable/player_btn_modern"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminate="true"
            android:indeterminateTint="#38BDF8" />

        <TextView
            android:id="@+id/tv_buffering_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:text="Yayın yükleniyor…" />
    </LinearLayout>

    <!-- Center Gesture HUD (Volume / Brightness / Seek indicator) -->
    <TextView
        android:id="@+id/tv_gesture_hud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/player_btn_modern"
        android:paddingStart="26dp"
        android:paddingTop="16dp"
        android:paddingEnd="26dp"
        android:paddingBottom="16dp"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:elevation="30dp" />

    <!-- Screen Lock Overlay Button -->
    <Button
        android:id="@+id/btn_floating_unlock"
        android:layout_width="wrap_content"
        android:layout_height="46dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/player_btn_modern"
        android:text="🔒 Kilidi Aç"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:elevation="40dp" />

    <!-- Main Player Controls Container (Top & Bottom Overlays) -->
    <FrameLayout
        android:id="@+id/player_controls_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <!-- Modern Top Header Bar with Gradient -->
        <LinearLayout
            android:id="@+id/player_top_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@drawable/player_gradient_top"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingTop="16dp"
            android:paddingEnd="18dp"
            android:paddingBottom="24dp">

            <!-- Circular Back Button -->
            <Button
                android:id="@+id/btn_top_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="◀"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:background="@drawable/player_btn_round" />

            <!-- Title & Live Badges -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <TextView
                    android:id="@+id/player_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="Seyir TV" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/badge_live"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/player_badge_live"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:text="● CANLI" />

                    <TextView
                        android:id="@+id/badge_hd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/player_badge_hd"
                        android:textColor="#38BDF8"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:text="1080p FHD" />

                    <TextView
                        android:id="@+id/player_status_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textColor="#94A3B8"
                        android:textSize="12sp"
                        android:text="Bağlanıyor…" />
                </LinearLayout>
            </LinearLayout>

            <!-- Digital Clock -->
            <TextView
                android:id="@+id/tv_player_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#E2E8F0"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginEnd="14dp"
                android:text="16:45" />

            <!-- Channels Quick Button -->
            <Button
                android:id="@+id/btn_top_channels"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="📺 Kanallar"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/player_btn_modern"
                android:layout_marginEnd="8dp" />

            <!-- Quick Exit Button -->
            <Button
                android:id="@+id/btn_top_close"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="✕"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:background="@drawable/player_btn_round" />
        </LinearLayout>

        <!-- Modern Bottom Control Bar with Gradient -->
        <LinearLayout
            android:id="@+id/player_bottom_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/player_gradient_bottom"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="16dp"
            android:paddingTop="32dp">

            <!-- Progress Seekbar row (Timeshift / Live indicator) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/tv_current_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#34D399"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:text="CANLI" />

                <SeekBar
                    android:id="@+id/player_progress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:progressTint="#38BDF8"
                    android:thumbTint="#FFFFFF"
                    android:max="1000" />

                <TextView
                    android:id="@+id/tv_total_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#94A3B8"
                    android:textSize="13sp"
                    android:text="🔴 CANLI YAYIN" />
            </LinearLayout>

            <!-- Modern Action Toolbar -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/tools_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <Button
                        android:id="@+id/btn_channels"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="📺 Kanallar"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:background="@drawable/player_btn_modern" />

                    <Button
                        android:id="@+id/btn_prev_channel"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="⏮ Önceki"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:background="@drawable/player_btn_modern"
                        android:layout_marginStart="8dp" />

                    <Button
                        android:id="@+id/btn_rewind"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="⏪ 10s"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:background="@drawable/player_btn_modern"
                        android:layout_marginStart="8dp" />

                    <Button
                        android:id="@+id/btn_play_pause"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:text="❚❚ Duraklat"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="@drawable/player_btn_modern"
                        android:layout_marginStart="8dp" />

                    <Button
                        android:id="@+id/btn_forward"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="10s ⏩"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:background="@drawable/player_btn_modern"
                        android:layout_marginStart="8dp" />

                    <Button
                        android:id="@+id/btn_next_channel"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="Sonraki ⏭"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:background="@drawable/player_btn_modern"
                        android:layout_marginStart="8dp" />

                    <Button
                        android:id="@+id/btn_quality"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="⚙️ Netlik: 1080p"
                        android:textColor="#38BDF8"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:background="@drawable/player_btn_modern"
                        android:layout_marginStart="8dp" />

                    <Button
                        android:id="@+id/btn_resize"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="📐 En-Boy: Sığdır"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:background="@drawable/player_btn_modern"
                        android:layout_marginStart="8dp" />

                    <Button
                        android:id="@+id/btn_next_source"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="🔄 Yedek Kaynak"
                        android:textColor="#FBBF24"
                        android:textSize="13sp"
                        android:background="@drawable/player_btn_modern"
                        android:layout_marginStart="8dp" />

                    <Button
                        android:id="@+id/btn_lock"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:visibility="gone"
                        android:text="🔓 Kilit" />

                    <Button
                        android:id="@+id/btn_audio"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:text="🔊 Ses"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:background="@drawable/player_btn_modern"
                        android:layout_marginStart="8dp"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/btn_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:text="💬 Altyazı"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:background="@drawable/player_btn_modern"
                        android:layout_marginStart="8dp"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/btn_speed"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:text="⚡ 1.0×"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:background="@drawable/player_btn_modern"
                        android:layout_marginStart="8dp"
                        android:visibility="gone" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>
    </FrameLayout>

    <!-- Modern Tivimate-style In-Player Channel Drawer (Sol Çekmece) -->
    <LinearLayout
        android:id="@+id/channel_sidebar"
        android:layout_width="340dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/player_sidebar_bg"
        android:orientation="vertical"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:visibility="gone"
        android:elevation="50dp">

        <!-- Sidebar Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_sidebar_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📺 KANAL LİSTESİ"
                    android:textColor="#38BDF8"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_sidebar_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="30 Kanal • Kumanda ile Seçin"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_close_sidebar"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:text="✕"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/player_btn_round" />
        </LinearLayout>

        <!-- Category Tabs / Filter Chips -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp">

            <Button
                android:id="@+id/btn_filter_all"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Tümü"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/player_btn_modern" />

            <Button
                android:id="@+id/btn_filter_sports"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Spor"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:background="@drawable/player_btn_modern"
                android:layout_marginStart="6dp" />

            <Button
                android:id="@+id/btn_filter_national"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Ulusal"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:background="@drawable/player_btn_modern"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#20FFFFFF"
            android:layout_marginBottom="6dp" />

        <!-- Channels ListView -->
        <ListView
            android:id="@+id/lv_sidebar_channels"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbars="vertical"
            android:choiceMode="singleChoice"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:descendantFocusability="afterDescendants"
            android:listSelector="@drawable/player_channel_item_selector" />
    </LinearLayout>

</FrameLayout>
