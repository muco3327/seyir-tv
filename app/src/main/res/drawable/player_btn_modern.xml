<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state on TV remote -->
    <item android:state_focused="true">
        <shape>
            <solid android:color="#2563EB" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="#93C5FD" />
        </shape>
    </item>
    <!-- Pressed state on mobile touch -->
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#1D4ED8" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- Normal state: sleek translucent glass -->
    <item>
        <shape>
            <solid android:color="#33FFFFFF" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#20FFFFFF" />
        </shape>
    </item>
</selector>
